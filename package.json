{
  "name": "epj",
  "version": "0.1.0",
  "private": true,
  "description": "Elektronisk pasientjournal for norske fastleger - FHIR R5, SMART on FHIR, SFM, NHN meldingstjener, Helfo",
  "type": "module",
  "engines": { "node": ">=22.6" },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --experimental-sqlite build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node --experimental-sqlite scripts/seed.js"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^22.13.0",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  },
  "dependencies": {}
}
