# ---------------------------------------------------------------------------
# Kopier til .env og fyll ut. Ingen av disse verdiene skal sjekkes inn.
# ---------------------------------------------------------------------------

# Kanonisk utadvendt adresse. Brukes som issuer i OAuth/OIDC-metadata.
EPJ_BASE_URL=http://localhost:5173

# PostgreSQL for applikasjonsdata (skjema `epj`).
EPJ_DATABASE_URL=postgres://epj:epj@localhost:5432/epj

# HAPI FHIR JPA-server (kliniske data). Skal ikke være tilgjengelig utenfra.
EPJ_HAPI_BASE_URL=http://localhost:8080/fhir
# EPJ_HAPI_USER=
# EPJ_HAPI_PASSWORD=

# Nøkkel for kryptering av data at rest (TOTP-hemmeligheter, private nøkler).
# Generer med: openssl rand -base64 48
EPJ_DATA_KEY=endre-meg-lokal-utvikling-0000000000000000

# Sikkerhet
EPJ_HTTPS_ONLY=false
EPJ_REQUIRE_MFA=true
EPJ_MAX_FAILED_LOGINS=5
EPJ_SESSION_IDLE_SECONDS=1800

# Pålogging: HelseID er hovedveien. Testinnlogging skal av i produksjon.
EPJ_HELSEID_ENABLED=false
EPJ_HELSEID_ISSUER=https://helseid-sts.test.nhn.no
EPJ_HELSEID_CLIENT_ID=
EPJ_HELSEID_KEY_ID=
EPJ_HELSEID_ALG=RS256
# PEM på én linje med \n som linjeskift, eller monter som fil og les inn.
EPJ_HELSEID_PRIVATE_KEY=
EPJ_HELSEID_REDIRECT_URI=http://localhost:5173/logg-inn/helseid/tilbake
EPJ_TESTINNLOGGING=true
EPJ_VIS_DEMOBRUKERE=true

# Virksomheten
EPJ_ORG_NAVN=Storgata Legesenter
EPJ_ORG_ORGNR=999999999
EPJ_ORG_HER_ID=8000001
EPJ_ORG_KOMMUNENR=0301

# Integrasjoner: `mock` kjører alt lokalt, `live` krever oppkobling mot NHN.
EPJ_INTEGRASJON_MODUS=mock
EPJ_SFM_BASE_URL=
EPJ_SFM_SCOPE=nhn:sfm/api
EPJ_NHN_MELDINGSTJENER_URL=
EPJ_NHN_ADRESSEREGISTER_URL=
EPJ_HELFO_OPPGJOR_URL=
EPJ_HELFO_EGENANDEL_URL=
EPJ_HELFO_AVTALE_ID=
